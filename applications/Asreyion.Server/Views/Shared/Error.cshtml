@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-4 max-w-2xl mx-auto">
    <div class="card border border-danger shadow-sm">
        <div class="card-header bg-danger bg-opacity-10 border-bottom border-danger p-4 d-flex align-items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation text-danger fs-1" aria-hidden="true"></i>
            <div>
                <h1 class="h3 text-danger fw-bold mb-1">An error occurred</h1>
                <p class="text-secondary mb-0">An unexpected error occurred while processing your request.</p>
            </div>
        </div>

        <div class="card-body p-4">
            @if (Model.ShowRequestId)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="fa-solid fa-bug" aria-hidden="true"></i>
                    <div>
                        <strong>Request ID:</strong> <code class="px-2 py-1 bg-dark text-white rounded">@Model.RequestId</code>
                    </div>
                </div>
            }

            <h2 class="h5 text-white fw-bold mb-2">Development Mode</h2>
            <p class="text-secondary">
                Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <p class="text-muted small mb-0">
                <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                It can result in displaying sensitive information from exceptions to end users.
            </p>
        </div>
    </div>
</div>
