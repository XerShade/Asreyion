<!-- Top Header - Logo and Auth -->
<nav class="navbar navbar-dark top-header">

    <div class="container">

        <!-- Logo/Brand -->
        <a class="navbar-brand modern-brand"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            <i class="fa-solid fa-diamond brand-icon"></i>
            <span class="brand-text">XerShade's Corner</span>
        </a>

        <!-- Account Navigation -->
        <div class="d-flex align-items-center gap-3">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Profile -->
                <a class="nav-link modern-nav-link modern-auth-link"
                   asp-area="Account"
                   asp-controller="Profile"
                   asp-action="Index">
                    <i class="fa-solid fa-user nav-icon"></i>
                    Profile
                </a>

                <!-- Settings Dropdown -->
                <div class="dropdown">

                    <button class="nav-link modern-nav-link modern-auth-link dropdown-toggle"
                            type="button"
                            id="settingsDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fa-solid fa-gear nav-icon"></i>
                        Settings
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end modern-dropdown"
                        aria-labelledby="settingsDropdown">

                        <!-- User Dashboard -->
                        <li>
                            <a class="dropdown-item"
                               asp-area="Account"
                               asp-controller="Manage"
                               asp-action="Index">
                                <i class="fa-solid fa-user-gear me-2"></i>
                                Account Settings
                            </a>
                        </li>

                        @if (User.IsInRole("Moderator") || User.IsInRole("Administrator"))
                        {
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                        }

                        @if (User.IsInRole("Moderator"))
                        {
                            <!-- Moderation Dashboard -->
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Moderation"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="fa-solid fa-shield-halved me-2"></i>
                                    Moderation Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrator"))
                        {
                            <!-- Administration Dashboard -->
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Administration"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="fa-solid fa-screwdriver-wrench me-2"></i>
                                    Administration Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                </div>

                <!-- Logout -->
                <form asp-area="Account"
                      asp-controller="Session"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger modern-btn-sm">
                        <i class="fa-solid fa-right-from-bracket nav-icon"></i>
                        Logout
                    </button>

                </form>
            }
            else
            {
                <!-- Login -->
                <a class="btn btn-outline-primary modern-btn-sm"
                   asp-area="Account"
                   asp-controller="Session"
                   asp-action="Login">
                    Login
                </a>
            }

        </div>

    </div>

</nav>