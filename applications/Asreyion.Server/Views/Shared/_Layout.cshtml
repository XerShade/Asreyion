<!DOCTYPE html>
<html lang="en">
@await Html.PartialAsync("_Head")
<body>

    @await Html.PartialAsync("_Navbar")

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    @await Html.PartialAsync("_Scripts")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>