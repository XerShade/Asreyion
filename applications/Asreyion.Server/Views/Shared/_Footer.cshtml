<footer class="modern-footer">
    <div class="container">
        <div class="footer-content">
            <!-- Brand Section -->
            <div class="footer-section footer-brand">
                <div class="footer-brand-logo">
                    <i class="fa-solid fa-diamond brand-icon"></i>
                    <span class="brand-text">Asreyion</span>
                </div>
                <p class="footer-tagline">Building the future of web experiences</p>
            </div>

            <!-- Links Section -->
            <div class="footer-section footer-links">
                <h4 class="footer-heading">Quick Links</h4>
                <ul class="footer-nav">
                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacy Policy
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Legal Section -->
            <div class="footer-section footer-legal">
                <h4 class="footer-heading">Legal</h4>
                <ul class="footer-nav">
                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Terms of Service
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacy Policy
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Social Section -->
            <div class="footer-section footer-social">
                <h4 class="footer-heading">Connect</h4>
                <div class="social-links">
                    <a href="#" class="social-link" aria-label="GitHub">
                        <i class="fa-brands fa-github social-icon"></i>
                    </a>
                    <a href="#" class="social-link" aria-label="Twitter">
                        <i class="fa-brands fa-x-twitter social-icon"></i>
                    </a>
                    <a href="#" class="social-link" aria-label="LinkedIn">
                        <i class="fa-brands fa-linkedin-in social-icon"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright Bar -->
        <div class="footer-bottom">
            <div class="copyright">
                &copy; @DateTime.Now.Year Asreyion. All rights reserved.
            </div>
            <div class="footer-bottom-links">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy Policy
                </a>
                <span class="separator">•</span>
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Terms of Service
                </a>
            </div>
        </div>
    </div>
</footer>
