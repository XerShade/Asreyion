<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>11561565-8d71-4fd2-89e4-d3f0b9e6e24f</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Asreyion.Modules.Blog</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Controllers\BlogController.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Controllers\CategoriesController.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Controllers\TagsController.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Data\BlogCategory.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Data\BlogPost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\Data\BlogTag.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Features\Blog\DbContexts\DataDbContext.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\Blog\Index.cshtml" />
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\Blog\Post.cshtml" />
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\Categories\Index.cshtml" />
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\Tags\Index.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\_ViewImports.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\_ViewStart.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Features\Blog\Views\Shared\_PostList.cshtml" />
  </ItemGroup>
</Project>