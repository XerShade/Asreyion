@model BlogPostInputModel
@{ bool editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit Blog Post" : "New Blog Post"; }

<section class="admin-page-intro" aria-labelledby="post-form-heading">
    <p class="admin-eyebrow"><a href="/Administration/Blog/Posts">Blog posts</a> / @(editing ? "Edit" : "New")</p>
    <h1 id="post-form-heading">@(editing ? "Edit post" : "Create a post")</h1>
    <p>Write your article and choose how it is organized on your site.</p>
</section>

<form class="admin-card admin-form" method="post" action="@(editing ? $"/Administration/Blog/Posts/{Model.Id}/Edit" : "/Administration/Blog/Posts/Create")">
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="admin-validation-summary" role="alert"></div>
    <div class="admin-form-grid">
        <div class="admin-field admin-field-wide"><label asp-for="Title" class="admin-label">Title <span class="admin-required">Required</span></label><input asp-for="Title" class="admin-control" autocomplete="off" placeholder="Give your post a clear title" /><span asp-validation-for="Title" class="admin-field-error"></span></div>
        <div class="admin-field admin-field-wide"><label asp-for="Slug" class="admin-label">URL slug <span class="admin-optional">Optional</span></label><input asp-for="Slug" class="admin-control" autocomplete="off" placeholder="Generated from the title when empty" aria-describedby="post-slug-help" /><span asp-validation-for="Slug" class="admin-field-error"></span><span class="admin-field-help" id="post-slug-help">Used in the post URL. Leave blank to generate it from the title.</span></div>
        <div class="admin-field admin-field-wide"><label asp-for="Body" class="admin-label">Content <span class="admin-required">Required</span></label><textarea asp-for="Body" class="admin-control admin-editor" rows="22" spellcheck="true" placeholder="Write your post content…" aria-describedby="post-body-help"></textarea><span asp-validation-for="Body" class="admin-field-error"></span><span class="admin-field-help" id="post-body-help">This field accepts HTML markup for headings, links, and formatting.</span></div>
        <div class="admin-field"><label asp-for="CategoryIds" class="admin-label">Categories</label><select asp-for="CategoryIds" class="admin-control admin-multiselect" multiple size="7" aria-describedby="post-categories-help">@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span class="admin-field-help" id="post-categories-help">Select any categories that apply. Use Ctrl or Command to select more than one.</span></div>
        <div class="admin-field"><label asp-for="TagIds" class="admin-label">Tags</label><select asp-for="TagIds" class="admin-control admin-multiselect" multiple size="7" aria-describedby="post-tags-help">@foreach (var tag in Model.Tags) { <option value="@tag.Id">@tag.Name</option> }</select><span class="admin-field-help" id="post-tags-help">Select any tags that apply. Use Ctrl or Command to select more than one.</span></div>
    </div>
    <div class="admin-form-actions"><button class="admin-btn admin-btn-primary" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> @(editing ? "Save changes" : "Create post")</button><a class="admin-btn admin-btn-secondary" href="/Administration/Blog/Posts">Cancel</a></div>
</form>
