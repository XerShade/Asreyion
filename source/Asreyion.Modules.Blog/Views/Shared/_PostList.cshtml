@model IReadOnlyList<BlogPost>

@{
    IReadOnlyDictionary<int, string> postUrlPaths = ViewData["PostUrlPaths"] as IReadOnlyDictionary<int, string>
        ?? new Dictionary<int, string>();
    IReadOnlyDictionary<int, string> categoryPaths = ViewData["CategoryPaths"] as IReadOnlyDictionary<int, string>
        ?? new Dictionary<int, string>();
}

@if (Model.Count == 0)
{
    <div class="p-4 text-center text-muted">
        <i class="fa-solid fa-inbox fs-3 mb-2" aria-hidden="true"></i>
        <p class="mb-0">No posts have been published yet.</p>
    </div>
}
else
{
    <div class="post-list d-flex flex-column gap-4">
        @foreach (var post in Model)
        {
            string postPath = postUrlPaths.TryGetValue(post.Id, out string? configuredPostPath)
                ? configuredPostPath
                : post.Slug;

            <article class="p-4 rounded-3 bg-tertiary border border-secondary shadow-sm">
                <h3 class="h4 mb-2">
                    <a asp-area="Blog"
                       asp-controller="Posts"
                       asp-action="Index"
                       asp-route-path="@postPath"
                       class="text-white text-decoration-none hover-primary">
                        @post.Title
                    </a>
                </h3>

                <div class="post-meta text-muted small mb-3 d-flex flex-wrap align-items-center gap-2">
                    <span><i class="fa-solid fa-calendar me-1" aria-hidden="true"></i> @post.Created.ToString("MMMM d, yyyy")</span>

                    @if (post.Modified > post.Created)
                    {
                        <span>• Updated: @post.Modified.ToString("MMMM d, yyyy")</span>
                    }

                    @if (post.Author is not null)
                    {
                        <span>• <i class="fa-solid fa-user me-1" aria-hidden="true"></i> @post.Author.UserName</span>
                    }

                    @if (post.Categories.Count > 0)
                    {
                        <span class="ms-2">
                            in:
                            @foreach (var category in post.Categories)
                            {
                                string categoryPath = categoryPaths.TryGetValue(category.Id, out string? configuredCategoryPath)
                                    ? configuredCategoryPath
                                    : category.Slug;

                                <a asp-area="Blog"
                                   asp-controller="Categories"
                                   asp-action="Index"
                                   asp-route-slug="@categoryPath"
                                   class="badge bg-outline-primary text-decoration-none me-1">
                                    <i class="fa-solid fa-folder me-1" aria-hidden="true"></i>@category.Name
                                </a>
                            }
                        </span>
                    }
                </div>

                @if (post.Tags.Count > 0)
                {
                    <div class="post-tags mb-3">
                        <span class="text-muted small me-2"><i class="fa-solid fa-tags me-1" aria-hidden="true"></i>Tags:</span>
                        @foreach (var tag in post.Tags)
                        {
                            <a asp-area="Blog"
                               asp-controller="Tags"
                               asp-action="Index"
                               asp-route-slug="@tag.Name"
                               class="badge bg-secondary text-decoration-none me-1">
                                #@tag.Name
                            </a>
                        }
                    </div>
                }

                <div>
                    <a asp-area="Blog"
                       asp-controller="Posts"
                       asp-action="Index"
                       asp-route-path="@postPath"
                       class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1"
                       aria-label="Read full post: @post.Title">
                        Read post <i class="fa-solid fa-arrow-right fs-xs" aria-hidden="true"></i>
                    </a>
                </div>
            </article>
        }
    </div>
}
