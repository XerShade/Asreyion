@model IReadOnlyList<BlogPost>

@{
    var tag = ViewBag.Tag as BlogTag;

    ViewData["Title"] = tag?.Name ?? "Tag";
}

<div class="card border border-secondary shadow-sm mb-4">
    <div class="card-header bg-tertiary border-bottom border-secondary p-4">
        <h1 class="card-title h3 text-white fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-hashtag text-primary" aria-hidden="true"></i>
            Tag: #@tag?.Name
        </h1>
    </div>

    <div class="card-body p-4">
        <partial name="_PostList" model="Model" />
    </div>
</div>