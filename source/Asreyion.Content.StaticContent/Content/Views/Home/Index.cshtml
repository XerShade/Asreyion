@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero-section mb-4 p-4 p-md-5 text-center bg-tertiary rounded-3 border border-secondary shadow-sm">
    <div class="max-w-75 mx-auto">
        <div class="mb-3">
            <span class="badge bg-primary text-dark fw-bold px-3 py-2 rounded-pill">Welcome to XerShade's Corner</span>
        </div>
        <h1 class="display-4 fw-bold text-white mb-3">Building Next-Gen Web Experiences</h1>
        <p class="lead text-secondary mb-4">
            Welcome to my personal site and developer platform. Actively under development with modern web standards and responsive architecture.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="https://github.com/XerShade/Asreyion"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary modern-btn-sm d-inline-flex align-items-center"
               aria-label="View Asreyion repository on GitHub (opens in a new tab)">
                <i class="fa-brands fa-github me-2" aria-hidden="true"></i> View Project Source
            </a>
            <a href="https://discord.xershade.ca/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-outline-primary modern-btn-sm d-inline-flex align-items-center"
               aria-label="Join Community Discord Server (opens in a new tab)">
                <i class="fa-brands fa-discord me-2" aria-hidden="true"></i> Join Community
            </a>
            <a href="https://www.youtube.com/XerShade"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-secondary modern-btn-sm d-inline-flex align-items-center"
               aria-label="Visit YouTube Channel (opens in a new tab)">
                <i class="fa-brands fa-youtube me-2" aria-hidden="true"></i> YouTube
            </a>
        </div>
    </div>
</section>

<!-- Main Feed Section -->
<section class="card border border-secondary shadow-sm mb-4 p-0">
    <div class="card-header bg-tertiary border-bottom border-secondary d-flex align-items-center justify-content-between">
        <h2 class="h5 mb-0 text-white d-flex align-items-center gap-2">
            <i class="fa-solid fa-newspaper text-primary" aria-hidden="true"></i>
            Recent Posts & Updates
        </h2>
    </div>
    <div class="card-body">
        <partial name="_PostList" model="Model" />
    </div>
</section>