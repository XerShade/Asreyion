@model IReadOnlyList<string>

<li class="nav-item dropdown">
    <a class="nav-link modern-nav-link dropdown-toggle"
       href="#"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">

        <i class="fa-solid fa-fw fa-blog nav-icon"></i>
        Blog
        <i class="fa-solid fa-fw fa-chevron-down dropdown-arrow"></i>
    </a>

    <ul class="dropdown-menu">

        <li>
            <a class="dropdown-item"
               asp-area=""
               asp-controller="Blog"
               asp-action="Index">

                <i class="fa-solid fa-fw fa-newspaper me-2"></i>
                All Posts
            </a>
        </li>

        @if (Model.Count > 0)
        {
            <li>
                <hr class="dropdown-divider">
            </li>

            <li>
                <h6 class="dropdown-header">
                    Categories
                </h6>
            </li>

            @foreach (var category in Model)
            {
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Blog"
                       asp-action="Category"
                       asp-route-categorySlug="@category">

                        <i class="fa-solid fa-fw fa-folder me-2"></i>
                        @category
                    </a>
                </li>
            }
        }

    </ul>
</li>