@model Asreyion.Core.Members.Models.MemberListModel

@{
    ViewData["Title"] = "Community Members";
}

<div class="card border border-secondary shadow-sm mb-4">
    <div class="card-header bg-tertiary border-bottom border-secondary p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="mb-2">
                <span class="badge bg-primary text-dark fw-bold px-3 py-1 rounded-pill">Community</span>
            </div>
            <h1 class="card-title h3 text-white fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="fa-solid fa-users text-primary" aria-hidden="true"></i>
                Members Directory
            </h1>
            <p class="lead text-secondary mb-0 fs-6">
                Discover and connect with people who have joined XerShade's Corner.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary text-secondary border border-secondary px-3 py-2 fs-6 rounded-pill d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-user-group text-primary" aria-hidden="true"></i>
                @Model.TotalMembers @(Model.TotalMembers == 1 ? "Member" : "Members")
            </span>
        </div>
    </div>

    <div class="card-body p-4" id="member-list-content" aria-live="polite" aria-busy="false" tabindex="-1">
        @await Html.PartialAsync("_MemberList", Model)
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const content = document.getElementById("member-list-content");

            if (!content) {
                return;
            }

            async function loadPage(url, updateHistory) {
                content.setAttribute("aria-busy", "true");

                try {
                    const response = await fetch(url, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (!response.ok) {
                        window.location.assign(url);
                        return;
                    }

                    content.innerHTML = await response.text();

                    if (updateHistory) {
                        window.history.pushState({}, "", url);
                    }

                    content.focus({ preventScroll: true });
                } catch {
                    window.location.assign(url);
                } finally {
                    content.setAttribute("aria-busy", "false");
                }
            }

            content.addEventListener("click", (event) => {
                const link = event.target.closest("a[data-member-page]");

                if (!link || link.getAttribute("aria-disabled") === "true" || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                    return;
                }

                event.preventDefault();
                loadPage(link.href, true);
            });

            window.addEventListener("popstate", () => {
                loadPage(window.location.href, false);
            });
        })();
    </script>
}
