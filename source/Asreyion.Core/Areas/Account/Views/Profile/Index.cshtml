@model Asreyion.Core.Areas.Account.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container py-4 max-w-2xl mx-auto">
    <div class="card border border-secondary shadow-sm">
        <div class="card-header bg-tertiary border-bottom border-secondary p-4 d-flex align-items-center gap-3">
            <div class="bg-primary text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 56px; height: 56px;">
                @(Model.DisplayName.FirstOrDefault().ToString().ToUpper())
            </div>
            <div>
                <h1 class="h3 mb-0 text-white fw-bold">@Model.DisplayName</h1>
                <span class="badge bg-outline-primary mt-1">User Profile</span>
            </div>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-secondary fw-semibold mb-2">
                    <i class="fa-solid fa-user me-2 text-primary" aria-hidden="true"></i>Username
                </dt>
                <dd class="col-sm-8 text-white fw-medium mb-3">
                    @Model.UserName
                </dd>

                <dt class="col-sm-4 text-secondary fw-semibold mb-2">
                    <i class="fa-solid fa-calendar-days me-2 text-primary" aria-hidden="true"></i>Member Since
                </dt>
                <dd class="col-sm-8 text-white fw-medium mb-0">
                    @Model.CreatedAt.ToString("MMMM d, yyyy")
                </dd>
            </dl>
        </div>
    </div>
</div>