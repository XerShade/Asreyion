@model Asreyion.Core.Areas.Account.Models.ManageViewModel
@using System.Linq

@{
    ViewData["Title"] = "Account Settings";
}

<div class="control-panel-layout">

    <!-- Sidebar -->
    <aside class="control-panel-sidebar">
        @await Html.PartialAsync("_Sidebar")
    </aside>


    <!-- Main content -->
    <main class="control-panel-main-content">

        <div class="control-panel-card">

            <div class="control-panel-card-header">
                <h1 class="control-panel-card-title">
                    Account Settings
                </h1>
            </div>


            <div class="control-panel-card-body">

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }

                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <form asp-action="Update"
                      asp-controller="Manage"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- Username -->
                    <div class="mb-3">

                        <label asp-for="UserName"
                               class="form-label">
                            Username
                        </label>

                        <input asp-for="UserName"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="UserName"
                              class="text-danger"></span>

                    </div>


                    <!-- Email -->
                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>


                    <!-- Display name -->
                    <div class="mb-3">

                        <label asp-for="DisplayName"
                               class="form-label">
                            Display Name
                        </label>

                        <input asp-for="DisplayName"
                               class="form-control" />

                        <span asp-validation-for="DisplayName"
                              class="text-danger"></span>

                    </div>


                    <!-- Save changes -->
                    <button type="submit"
                            class="control-panel-btn control-panel-btn-primary">
                        Save Changes
                    </button>

                </form>

            </div>

        </div>

        <div class="control-panel-card">
            <div class="control-panel-card-body">

                <h1 class="control-panel-card-title">
                    External Logins
                </h1>

                @{
                    var availableProviders = new[] { "Google" };
                    var connectedProviders = Model.ExternalLogins?.Select(l => l.LoginProvider).ToList() ?? new List<string>();
                }

                @foreach (var provider in availableProviders)
                {
                    var isConnected = connectedProviders.Contains(provider);
                    var login = Model.ExternalLogins?.FirstOrDefault(l => l.LoginProvider == provider);

                    <div class="d-flex justify-content-between align-items-center mb-1 p-3 rounded control-panel-card-inset">
                        <div>
                            <span class="fw-bold"><i class="fab fa-fw fa-@provider.ToLower()"></i> @provider</span>
                        </div>

                        @if (isConnected && login != null)
                        {
                            <form asp-area="Account"
                                  asp-controller="Manage"
                                  asp-action="DisconnectExternalLogin"
                                  method="post"
                                  class="mb-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="@login.LoginProvider" />
                                <input type="hidden" name="providerKey" value="@login.ProviderKey" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Disconnect
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Account"
                                  asp-controller="Manage"
                                  asp-action="ConnectExternalLogin"
                                  method="post"
                                  class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        name="provider"
                                        value="@provider"
                                        class="btn btn-sm btn-outline-danger">
                                    Connect
                                </button>
                            </form>
                        }
                    </div>
                }

            </div>

        </div>

    </main>

</div>