@model Asreyion.Core.Areas.Administration.Models.AdminSidebarViewModel

@{
    var sidebarModel = ViewData["SidebarModel"] as AdminSidebarViewModel ?? new AdminSidebarViewModel();
}

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!-- Dashboard Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Main</div>

    <a href="/Administration/Dashboard" class="admin-nav-item @(currentController == "Dashboard" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-house fa-fw"></i>
        Dashboard
    </a>
</div>

<!-- Management Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Management</div>

    <a href="/Administration/Users" class="admin-nav-item @(currentController == "Users" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-users fa-fw"></i>
        Users
    </a>

    <a href="/Administration/Roles" class="admin-nav-item @(currentController == "Roles" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-shield-halved fa-fw"></i>
        Roles
    </a>

    <a href="/Administration/Permissions" class="admin-nav-item @(currentController == "Permissions" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-key fa-fw"></i>
        Permissions
    </a>
</div>

<!-- Content Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Content</div>

    <a href="/Administration/Content/Pages" class="admin-nav-item @(currentController == "Content" && currentAction == "Pages" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-file-lines fa-fw"></i>
        Pages
    </a>

    <a href="/Administration/Content/Media" class="admin-nav-item @(currentController == "Content" && currentAction == "Media" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-images fa-fw"></i>
        Media
    </a>
</div>

<!-- System Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">System</div>

    <a href="/Administration/System/Settings" class="admin-nav-item @(currentController == "System" && currentAction == "Settings" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-gear fa-fw"></i>
        Settings
    </a>

    <a href="/Administration/System/Logs" class="admin-nav-item @(currentController == "System" && currentAction == "Logs" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-clipboard-list fa-fw"></i>
        Logs
    </a>

    <a href="/Administration/System/Modules" class="admin-nav-item @(currentController == "System" && currentAction == "Modules" ? "active" : "")">
        <i class="admin-nav-item-icon fa-solid fa-cubes fa-fw"></i>
        Modules
    </a>
</div>

<!-- Custom Section - For modular extensions -->
@if (sidebarModel?.CustomSections != null)
{
    foreach (var navSection in sidebarModel.CustomSections)
    {
        <div class="admin-nav-section">
            <div class="admin-nav-section-title">@navSection.Title</div>

            @foreach (var item in navSection.Items)
            {
                <a href="@item.Url" class="admin-nav-item @(item.IsActive ? "active" : "")">
                    @if (!string.IsNullOrEmpty(item.IconSvg))
                    {
                        <i class="admin-nav-item-icon @item.IconSvg fa-fw"></i>
                    }

                    @item.Label
                </a>
            }
        </div>
    }
}