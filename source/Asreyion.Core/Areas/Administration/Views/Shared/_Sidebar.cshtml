@model Asreyion.Core.Areas.Administration.Models.AdminSidebarViewModel

@{
    var sidebarModel = ViewData["SidebarModel"] as AdminSidebarViewModel ?? new AdminSidebarViewModel();
}

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!-- Dashboard Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Main</div>
    
    <a href="/Administration/Dashboard" class="admin-nav-item @(currentController == "Dashboard" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Dashboard
    </a>
</div>

<!-- Management Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Management</div>
    
    <a href="/Administration/Users" class="admin-nav-item @(currentController == "Users" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        Users
    </a>
    
    <a href="/Administration/Roles" class="admin-nav-item @(currentController == "Roles" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        Roles
    </a>
    
    <a href="/Administration/Permissions" class="admin-nav-item @(currentController == "Permissions" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
        Permissions
    </a>
</div>

<!-- Content Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">Content</div>
    
    <a href="/Administration/Content/Pages" class="admin-nav-item @(currentController == "Content" && currentAction == "Pages" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Pages
    </a>
    
    <a href="/Administration/Content/Media" class="admin-nav-item @(currentController == "Content" && currentAction == "Media" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Media
    </a>
</div>

<!-- System Section -->
<div class="admin-nav-section">
    <div class="admin-nav-section-title">System</div>
    
    <a href="/Administration/System/Settings" class="admin-nav-item @(currentController == "System" && currentAction == "Settings" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Settings
    </a>
    
    <a href="/Administration/System/Logs" class="admin-nav-item @(currentController == "System" && currentAction == "Logs" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        Logs
    </a>
    
    <a href="/Administration/System/Modules" class="admin-nav-item @(currentController == "System" && currentAction == "Modules" ? "active" : "")">
        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        Modules
    </a>
</div>

<!-- Custom Section - For modular extensions -->
@if (sidebarModel?.CustomSections != null)
{
    foreach (var navSection in sidebarModel.CustomSections)
    {
        <div class="admin-nav-section">
            <div class="admin-nav-section-title">@navSection.Title</div>
            
            @foreach (var item in navSection.Items)
            {
                <a href="@item.Url" class="admin-nav-item @(item.IsActive ? "active" : "")">
                    @if (!string.IsNullOrEmpty(item.IconSvg))
                    {
                        <svg class="admin-nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            @Html.Raw(item.IconSvg)
                        </svg>
                    }
                    @item.Label
                </a>
            }
        </div>
    }
}
