<a class="admin-header-action" target="_blank"
   asp-area=""
   asp-controller="Home"
   asp-action="Index">
    <i class="fa-solid fa-external-link fa-fw"></i>
    View Site
</a>

<a class="admin-header-action" target="_blank"
   asp-area="Account"
   asp-controller="Profile"
   asp-action="Index">
    <i class="fa-solid fa-user nav-icon"></i>
    Profile
</a>

<form asp-area="Authentication"
      asp-controller="Session"
      asp-action="Logout"
      method="post"
      class="d-inline">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-outline-danger modern-btn-sm admin-header-action">
        <i class="fa-solid fa-right-from-bracket nav-icon"></i>
        Logout
    </button>

</form>