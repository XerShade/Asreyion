@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!-- Dashboard Section -->
<div class="moderation-nav-section">
    <div class="moderation-nav-section-title">Overview</div>

    <a href="/Moderation/Dashboard"
       class="moderation-nav-item @(currentController == "Dashboard" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-house fa-fw"></i>
        Dashboard
    </a>
</div>

<!-- Content Moderation Section -->
<div class="moderation-nav-section">
    <div class="moderation-nav-section-title">Content</div>

    <a href="/Moderation/Content/Reports"
       class="moderation-nav-item @(currentController == "Content" && currentAction == "Reports" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-triangle-exclamation fa-fw"></i>
        Content Reports
    </a>

    <a href="/Moderation/Content/Queue"
       class="moderation-nav-item @(currentController == "Content" && currentAction == "Queue" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-inbox fa-fw"></i>
        Moderation Queue
    </a>

    <a href="/Moderation/Content/Approved"
       class="moderation-nav-item @(currentController == "Content" && currentAction == "Approved" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-circle-check fa-fw"></i>
        Approved Content
    </a>

    <a href="/Moderation/Content/Removed"
       class="moderation-nav-item @(currentController == "Content" && currentAction == "Removed" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-trash-can fa-fw"></i>
        Removed Content
    </a>
</div>

<!-- User Moderation Section -->
<div class="moderation-nav-section">
    <div class="moderation-nav-section-title">Users</div>

    <a href="/Moderation/Users/Reports"
       class="moderation-nav-item @(currentController == "Users" && currentAction == "Reports" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-users fa-fw"></i>
        User Reports
    </a>

    <a href="/Moderation/Users/Flagged"
       class="moderation-nav-item @(currentController == "Users" && currentAction == "Flagged" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-flag fa-fw"></i>
        Flagged Users
    </a>

    <a href="/Moderation/Users/Warned"
       class="moderation-nav-item @(currentController == "Users" && currentAction == "Warned" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-triangle-exclamation fa-fw"></i>
        Warned Users
    </a>

    <a href="/Moderation/Users/Banned"
       class="moderation-nav-item @(currentController == "Users" && currentAction == "Banned" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-ban fa-fw"></i>
        Banned Users
    </a>
</div>

<!-- Actions Section -->
<div class="moderation-nav-section">
    <div class="moderation-nav-section-title">Actions</div>

    <a href="/Moderation/Actions/History"
       class="moderation-nav-item @(currentController == "Actions" && currentAction == "History" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-clock-rotate-left fa-fw"></i>
        Action History
    </a>

    <a href="/Moderation/Actions/Appeals"
       class="moderation-nav-item @(currentController == "Actions" && currentAction == "Appeals" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-comments fa-fw"></i>
        Appeals
    </a>
</div>

<!-- Settings Section -->
<div class="moderation-nav-section">
    <div class="moderation-nav-section-title">Settings</div>

    <a href="/Moderation/Settings/Rules"
       class="moderation-nav-item @(currentController == "Settings" && currentAction == "Rules" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-list-check fa-fw"></i>
        Moderation Rules
    </a>

    <a href="/Moderation/Settings/Automod"
       class="moderation-nav-item @(currentController == "Settings" && currentAction == "Automod" ? "active" : "")">
        <i class="moderation-nav-item-icon fa-solid fa-robot fa-fw"></i>
        Auto-Moderation
    </a>
</div>