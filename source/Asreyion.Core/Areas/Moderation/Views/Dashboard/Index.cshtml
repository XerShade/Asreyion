@model Asreyion.Core.Areas.Moderation.Models.ModerationDashboardViewModel

@{
    ViewData["Title"] = "Moderation Dashboard";
}

<div class="moderation-page-layout">

    <!-- ==================== Sidebar ==================== -->
    <aside class="moderation-sidebar">
        @await Html.PartialAsync("_Sidebar")
    </aside>


    <!-- ==================== Main Content ==================== -->
    <main class="moderation-main-content">

        <!-- ==================== Statistics Cards ==================== -->
        <div class="moderation-grid moderation-grid-4">

            <div class="moderation-stat-card moderation-stat-card-warning">
                <div class="moderation-stat-icon">
                    <i class="fa-solid fa-triangle-exclamation fa-fw"></i>
                </div>

                <div class="moderation-stat-value">
                    @Model.PendingReports
                </div>

                <div class="moderation-stat-label">
                    Pending Reports
                </div>

                <div class="moderation-stat-change">
                    Requires attention
                </div>
            </div>


            <div class="moderation-stat-card moderation-stat-card-success">
                <div class="moderation-stat-icon">
                    <i class="fa-solid fa-circle-check fa-fw"></i>
                </div>

                <div class="moderation-stat-value">
                    @Model.ReportsReviewedToday
                </div>

                <div class="moderation-stat-label">
                    Reviewed Today
                </div>

                <div class="moderation-stat-change positive">
                    Keep up the good work
                </div>
            </div>


            <div class="moderation-stat-card moderation-stat-card-danger">
                <div class="moderation-stat-icon">
                    <i class="fa-solid fa-users fa-fw"></i>
                </div>

                <div class="moderation-stat-value">
                    @Model.FlaggedUsers
                </div>

                <div class="moderation-stat-label">
                    Flagged Users
                </div>

                <div class="moderation-stat-change">
                    Review required
                </div>
            </div>


            <div class="moderation-stat-card moderation-stat-card-info">
                <div class="moderation-stat-icon">
                    <i class="fa-solid fa-bolt fa-fw"></i>
                </div>

                <div class="moderation-stat-value">
                    @Model.ActiveActions
                </div>

                <div class="moderation-stat-label">
                    Active Actions
                </div>

                <div class="moderation-stat-change">
                    In progress
                </div>
            </div>

        </div>


        <!-- ==================== Recent Content Reports ==================== -->
        <div class="moderation-card">

            <div class="moderation-card-header">
                <h3 class="moderation-card-title">
                    Recent Content Reports
                </h3>

                <div class="moderation-card-actions">
                    <a href="/Moderation/Content/Reports"
                       class="moderation-btn moderation-btn-secondary">
                        View All
                    </a>
                </div>
            </div>


            <div class="moderation-table-container">
                <table class="moderation-table">

                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Content Preview</th>
                            <th>Reporter</th>
                            <th>Author</th>
                            <th>Reason</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var report in Model.RecentContentReports)
                        {
                            <tr>

                                <td>
                                    <span class="moderation-badge moderation-badge-type">
                                        @report.ContentType
                                    </span>
                                </td>

                                <td class="moderation-table-truncate">
                                    @report.ContentPreview
                                </td>

                                <td>
                                    @report.ReporterUsername
                                </td>

                                <td>
                                    @report.AuthorUsername
                                </td>

                                <td>
                                    @report.Reason
                                </td>

                                <td>
                                    <span class="moderation-badge @report.PriorityClass">
                                        @report.Priority
                                    </span>
                                </td>

                                <td>
                                    <span class="moderation-badge @report.StatusClass">
                                        @report.Status
                                    </span>
                                </td>

                                <td>
                                    @report.CreatedAt.ToString("MMM dd, HH:mm")
                                </td>

                                <td>
                                    <div class="moderation-action-buttons">

                                        <button class="moderation-btn moderation-btn-sm moderation-btn-success"
                                                title="Approve">
                                            <i class="fa-solid fa-check fa-fw"></i>
                                        </button>


                                        <button class="moderation-btn moderation-btn-sm moderation-btn-danger"
                                                title="Remove">
                                            <i class="fa-solid fa-xmark fa-fw"></i>
                                        </button>


                                        <button class="moderation-btn moderation-btn-sm moderation-btn-secondary"
                                                title="View Details">
                                            <i class="fa-solid fa-eye fa-fw"></i>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>


        <!-- ==================== Recent User Reports ==================== -->
        <div class="moderation-card">

            <div class="moderation-card-header">
                <h3 class="moderation-card-title">
                    Recent User Reports
                </h3>

                <div class="moderation-card-actions">
                    <a href="/Moderation/Users/Reports"
                       class="moderation-btn moderation-btn-secondary">
                        View All
                    </a>
                </div>
            </div>


            <div class="moderation-table-container">
                <table class="moderation-table">

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Reporter</th>
                            <th>Reason</th>
                            <th>Reports</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var report in Model.RecentUserReports)
                        {
                            <tr>

                                <td>
                                    <div class="moderation-user-cell">

                                        <div class="moderation-user-avatar">
                                            @report.Username.Substring(0, 2).ToUpper()
                                        </div>

                                        <span>
                                            @report.Username
                                        </span>

                                    </div>
                                </td>

                                <td>
                                    @report.ReporterUsername
                                </td>

                                <td>
                                    @report.Reason
                                </td>

                                <td>
                                    @report.ReportCount
                                </td>

                                <td>
                                    <span class="moderation-badge @report.StatusClass">
                                        @report.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="moderation-action-buttons">

                                        <button class="moderation-btn moderation-btn-sm moderation-btn-warning"
                                                title="Warn">
                                            <i class="fa-solid fa-triangle-exclamation fa-fw"></i>
                                        </button>


                                        <button class="moderation-btn moderation-btn-sm moderation-btn-danger"
                                                title="Ban">
                                            <i class="fa-solid fa-ban fa-fw"></i>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>


        <!-- ==================== Moderation Queue ==================== -->
        <div class="moderation-card">

            <div class="moderation-card-header">
                <h3 class="moderation-card-title">
                    Moderation Queue
                </h3>

                <div class="moderation-card-actions">
                    <a href="/Moderation/Content/Queue"
                       class="moderation-btn moderation-btn-secondary">
                        View All
                    </a>
                </div>
            </div>


            <div class="moderation-queue-list">

                @foreach (var item in Model.ModerationQueue)
                {
                    <div class="moderation-queue-item">

                        <div class="moderation-queue-item-main">

                            <div class="moderation-queue-item-type">
                                @item.Type
                            </div>

                            <div class="moderation-queue-item-description">
                                @item.Description
                            </div>

                        </div>


                        <div class="moderation-queue-item-meta">

                            <span class="moderation-badge @item.PriorityClass">
                                @item.Priority
                            </span>

                            <span class="moderation-queue-item-time">
                                @item.TimeInQueue
                            </span>

                            @if (!string.IsNullOrEmpty(item.AssignedModerator))
                            {
                                <span class="moderation-queue-item-assignee">
                                    Assigned: @item.AssignedModerator
                                </span>
                            }

                        </div>


                        <div class="moderation-queue-item-actions">

                            <button class="moderation-btn moderation-btn-sm moderation-btn-primary">
                                Claim
                            </button>

                            <button class="moderation-btn moderation-btn-sm moderation-btn-secondary">
                                Skip
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- ==================== Recent Moderation Actions ==================== -->
        <div class="moderation-card">

            <div class="moderation-card-header">

                <h3 class="moderation-card-title">
                    Recent Moderation Actions
                </h3>

                <div class="moderation-card-actions">

                    <a href="/Moderation/Actions/History"
                       class="moderation-btn moderation-btn-secondary">
                        View History
                    </a>

                </div>

            </div>


            <div class="moderation-actions-list">

                @foreach (var action in Model.RecentActions)
                {
                    <div class="moderation-action-item">

                        <div class="moderation-action-item-icon">
                            <i class="fa-solid fa-clipboard-list fa-fw"></i>
                        </div>


                        <div class="moderation-action-item-content">

                            <div class="moderation-action-item-title">
                                @action.ModeratorUsername - @action.ActionType
                            </div>

                            <div class="moderation-action-item-target">
                                @action.Target
                            </div>

                            @if (!string.IsNullOrEmpty(action.Notes))
                            {
                                <div class="moderation-action-item-notes">
                                    @action.Notes
                                </div>
                            }

                        </div>


                        <div class="moderation-action-item-time">
                            @action.Timestamp.ToString("MMM dd, HH:mm")
                        </div>

                    </div>
                }

            </div>

        </div>

    </main>

</div>


@section Scripts {
    <script>
        // Auto-refresh dashboard data every 30 seconds
        setInterval(() => {
            console.log('Refreshing moderation dashboard data...');

            // Add your refresh logic here
        }, 30000);
    </script>
}