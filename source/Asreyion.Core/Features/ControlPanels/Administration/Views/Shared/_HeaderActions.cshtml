<a class="admin-header-action d-inline-flex align-items-center gap-1"
   target="_blank"
   rel="noopener noreferrer"
   asp-area=""
   asp-controller="Home"
   asp-action="Index"
   aria-label="View public site (opens in a new tab)">
    <i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i>
    View Site
</a>

<a class="admin-header-action d-inline-flex align-items-center gap-1"
   asp-area="Account"
   asp-controller="Profile"
   asp-action="Index">
    <i class="fa-solid fa-user nav-icon" aria-hidden="true"></i>
    Profile
</a>

<form asp-area="Authentication"
      asp-controller="Session"
      asp-action="Logout"
      method="post"
      class="d-inline">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-outline-danger modern-btn-sm admin-header-action d-inline-flex align-items-center gap-1"
            aria-label="Log out of admin panel">
        <i class="fa-solid fa-right-from-bracket nav-icon" aria-hidden="true"></i>
        Logout
    </button>

</form>