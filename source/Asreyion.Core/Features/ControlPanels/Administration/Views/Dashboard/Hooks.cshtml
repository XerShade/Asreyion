@model IReadOnlyList<Asreyion.Core.Features.ControlPanels.Administration.Models.HookStatusViewModel>
@{
    ViewData["Title"] = "Registered hooks";
}

<section class="admin-page-intro" aria-labelledby="hooks-heading">
    <p class="admin-eyebrow">Administration</p>
    <h1 id="hooks-heading">Registered hooks</h1>
    <p>Hook subscribers registered with the website's dependency injection container.</p>
</section>

<section class="admin-card" aria-labelledby="hooks-list-heading">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title" id="hooks-list-heading">Loaded subscribers</h2>
            <p class="admin-card-copy">@Model.Count subscriber@(Model.Count == 1 ? "" : "s") registered</p>
        </div>
    </div>

    <div class="admin-table-scroll" role="region" aria-label="Registered hook subscribers" tabindex="0">
        <table class="admin-table">
            <caption class="visually-hidden">Hook subscribers registered with the website's dependency injection container</caption>
            <thead>
                <tr>
                    <th scope="col">Subscriber</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Registered interfaces</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4"><div class="admin-empty-state"><span class="admin-empty-icon"><i class="fa-solid fa-plug-circle-xmark" aria-hidden="true"></i></span><strong>No hook subscribers registered</strong><span>Hook discovery has not registered any subscribers.</span></div></td></tr>
                }
                else
                {
                    @foreach (var hook in Model)
                    {
                        <tr>
                            <th scope="row"><code>@hook.ImplementationType</code></th>
                            <td>@(hook.Name ?? "—")</td>
                            <td>@(hook.Description ?? "—")</td>
                            <td>@string.Join(", ", hook.RegisteredFor)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
