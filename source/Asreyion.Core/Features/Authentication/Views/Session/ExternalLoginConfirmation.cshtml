@model Asreyion.Core.Features.Authentication.Models.ExternalLoginConfirmationViewModel

@{
    ViewData["Title"] = "Confirm External Login";
}

<div class="container">
    <h1>Confirm your account</h1>
    <p class="text-muted">
        You've successfully authenticated with <strong>@Model.Provider</strong>.
        Please enter a username and email for this site below and click the register button to finish
        logging in.
    </p>

    <div class="mb-3">
        <a asp-area="Authentication"
           asp-controller="Session"
           asp-action="ExternalLoginLinking"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="btn btn-outline-secondary">
            Link Existing Account Instead
        </a>
    </div>

    <form asp-area="Authentication"
          asp-controller="Session"
          asp-action="ExternalLoginConfirmation"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Provider" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"></div>

        <div class="mb-3">
            <label asp-for="UserName" class="form-label">
                Username
            </label>

            <input asp-for="UserName"
                   class="form-control"
                   autocomplete="username" />

            <span asp-validation-for="UserName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Email
            </label>

            <input asp-for="Email"
                   class="form-control"
                   autocomplete="email" />

            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label">
                Display Name
            </label>

            <input asp-for="DisplayName"
                   class="form-control"
                   autocomplete="name" />

            <span asp-validation-for="DisplayName"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Register
        </button>

    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
